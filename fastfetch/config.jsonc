// Cyberpunk neon — matches sketchybar teal scheme + p10k lavender
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "38;2;44;249;237",
      "2": "38;2;175;135;255"
    }
  },
  "display": {
    "color": {
      "keys": "38;2;44;249;237",
      "title": "38;2;235;70;249",
      "separator": "38;2;92;122;138"
    },
    "separator": " :: "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
