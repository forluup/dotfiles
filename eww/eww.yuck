;; eww — desktop widgets + dashboard, laid out after husseinhareb/hyprland-eww
;; (github.com/husseinhareb/hyprland-eww): the stacked vertical clock, the
;; circular resource rings, the album-art music card with transport controls,
;; the app grid, the audio sliders and the power row all come from that rice.
;; Recoloured into the cyberpunk-neon palette shared with waybar, wofi, bat,
;; fzf, eza, zsh, ghostty and sketchybar — not the reference's wallpaper-derived
;; Material You. Icon PNGs are replaced with Nerd Font glyphs.
;;
;; Two tiers, because a tiling WM cannot host the reference's always-on
;; foreground grid without it permanently covering your windows:
;;
;;   BOTTOM layer — clock / resources / media. Above the wallpaper, below tiled
;;   windows, so you see them on an empty workspace. Cannot take clicks.
;;   FOREGROUND  — dashboard. The interactive half, summoned with SUPER+W onto
;;   whichever monitor has focus (scripts/dashboard.sh), dismissed the same way.
;;
;; Each bottom-layer window is defined twice, the -2 copy pinned to monitor 1,
;; because an eww window is a single instance and cannot span monitors.
;; scripts/launch.sh opens that set only when a second monitor is connected.

;; ---- data -------------------------------------------------------------------
;; CPU/RAM/DISK need no polling: eww ships them as auto-updating built-ins.
(defpoll hour     :interval "5s"  `date +%H`)
(defpoll minute   :interval "5s"  `date +%M`)
(defpoll dayname  :interval "1h"  `date +%A`)
(defpoll daydate  :interval "1h"  `date +%d/%m`)
(defpoll weather  :interval "15m" :initial "…" `curl -sf 'wttr.in/?format=%t+%C' | tr -d '+'`)

(defpoll music :interval "2s" :initial `{"title":"…","artist":"","glyph":"","art":""}`
  "~/.config/eww/scripts/music.sh")
(defpoll audio :interval "2s" :initial `{"volume":0,"mic":0,"sink_icon":"","mic_icon":""}`
  "~/.config/eww/scripts/audio.sh")
(defpoll net :interval "3s" :initial `{"iface":"…","ssid":"","down":"--","up":"--"}`
  "~/.config/eww/scripts/netstat.sh")
(defpoll sys :interval "1h" :initial `{"user":"…","host":"…","uptime":"…","kernel":"…","pkgs":"…"}`
  "~/.config/eww/scripts/sysinfo.sh")

;; ---- shared pieces ----------------------------------------------------------
;; The reference stacks the clock vertically instead of writing HH:MM across —
;; that is the single most recognisable thing about the layout, so it stays.
(defwidget vclock []
  (box :class "card" :orientation "v" :space-evenly false :spacing 2
    (label :class "clock-hour"   :text hour)
    (label :class "clock-minute" :text minute)
    (label :class "clock-day"    :text dayname)
    (label :class "clock-date"   :text daydate)
    (label :class "clock-wx"     :text weather :limit-width 22)))

;; one ring from the reference's `resources` widget
(defwidget ring [name value]
  (box :orientation "v" :space-evenly false :spacing 6 :halign "center"
    (box :class "ringbox" :halign "center"
      (circular-progress :class "ring" :value value :thickness 6
                         :start-at 75 :clockwise true :hexpand true :vexpand true
        (label :class "ring-label" :text "${round(value, 0)}")))
    (label :class "ring-name" :text name)))

(defwidget rings []
  (box :class "card" :orientation "v" :space-evenly false :spacing 14
    (ring :name "CPU"  :value {EWW_CPU.avg})
    (ring :name "MEM"  :value {EWW_RAM.used_mem_perc})
    (ring :name "DISK" :value {EWW_DISK["/"].used_perc})
    (box :class "netblock" :orientation "v" :space-evenly false :spacing 2
      (label :class "net-rate" :text " ${net.down}" :limit-width 13)
      (label :class "net-rate" :text " ${net.up}"   :limit-width 13)
      (label :class "net-name" :text {net.ssid != "" ? net.ssid : net.iface} :limit-width 13))))

;; the reference's profile card, minus the avatar image
(defwidget profile []
  (box :class "profile" :orientation "v" :space-evenly false :spacing 6
    (label :class "profile-name" :text "${sys.user}@${sys.host}")
    (label :class "profile-line" :text " ${sys.uptime}")
    (label :class "profile-line" :text " ${sys.kernel}    ${sys.pkgs}")))

;; ---- bottom-layer widgets ---------------------------------------------------
;; A read-only echo of the music card: same art and text, no buttons, because
;; nothing on the bottom layer can receive a click.
(defwidget nowplaying []
  (box :class "card now" :space-evenly false :spacing 12 :halign "center"
    (box :class "art-small" :visible {music.art != ""} :style "background-image: url('${music.art}');")
    (box :orientation "v" :space-evenly false :valign "center"
      (label :class "now-title"  :text {music.title}  :limit-width 40 :halign "center")
      (label :class "now-artist" :text {music.artist} :visible {music.artist != ""} :limit-width 40 :halign "center"))))

;; ---- dashboard --------------------------------------------------------------
(defwidget musiccard []
  (box :class "panel" :space-evenly false :spacing 18
    (box :class "art-large" :visible {music.art != ""} :style "background-image: url('${music.art}');")
    (box :orientation "v" :space-evenly false :spacing 10 :valign "center" :hexpand true
      (label :class "song"   :text {music.title}  :limit-width 30 :halign "center")
      (label :class "artist" :text {music.artist} :limit-width 30 :halign "center")
      (box :class "transport" :space-evenly false :spacing 18 :halign "center"
        (button :class "tbtn" :onclick "playerctl previous" "")
        (button :class "tbtn play" :onclick "playerctl play-pause" {music.glyph})
        (button :class "tbtn" :onclick "playerctl next" "")))))

;; the reference's app grid, with its PNG buttons swapped for Nerd Font glyphs
(defwidget apps []
  (box :class "panel"
    (box :space-evenly false :spacing 14 :halign "center"
    (button :class "app" :tooltip "Terminal"   :onclick "hyprctl dispatch exec ghostty" "")
    (button :class "app" :tooltip "Browser"    :onclick "hyprctl dispatch exec google-chrome-stable" "")
    (button :class "app" :tooltip "Files"      :onclick "hyprctl dispatch exec nautilus" "")
    (button :class "app" :tooltip "Editor"     :onclick "hyprctl dispatch exec 'ghostty -e nvim'" "")
    (button :class "app" :tooltip "Launcher"   :onclick "wofi --show drun" ""))))

;; volume + mic only: this machine has no /sys/class/backlight, so the
;; reference's brightness slider has nothing to drive
(defwidget sliders []
  (box :class "panel" :orientation "v" :space-evenly false :spacing 16
    (box :space-evenly false :spacing 14
      (button :class "slider-icon" :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle" {audio.sink_icon})
      (scale :class "slider" :hexpand true :min 0 :max 101 :value {audio.volume}
             :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%"))
    (box :space-evenly false :spacing 14
      (button :class "slider-icon" :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle" {audio.mic_icon})
      (scale :class "slider" :hexpand true :min 0 :max 101 :value {audio.mic}
             :onchange "pactl set-source-volume @DEFAULT_SOURCE@ {}%"))))

(defwidget power []
  (box :class "panel"
    (box :space-evenly false :spacing 14 :halign "center"
    (button :class "pbtn" :tooltip "Lock"     :onclick "eww close dashboard; hyprlock" "")
    (button :class "pbtn" :tooltip "Suspend"  :onclick "eww close dashboard; systemctl suspend" "")
    (button :class "pbtn" :tooltip "Log out"  :onclick "hyprctl dispatch exit" "")
    (button :class "pbtn" :tooltip "Reboot"   :onclick "systemctl reboot" "")
    (button :class "pbtn danger" :tooltip "Power off" :onclick "systemctl poweroff" ""))))

(defwidget dashboard-body []
  (box :class "dash" :orientation "v" :space-evenly false :spacing 16
    (profile)
    (musiccard)
    (sliders)
    (apps)
    (power)))

;; ---- windows ----------------------------------------------------------------
;; x/y match hyprland's gaps (7 at the sides, 48 = 37px bar + 11px top gap) so
;; the widgets line up with where tiled windows start.
(defwindow clock
  :monitor 0 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "top left" :x "7px" :y "48px" :width "150px")
  (vclock))

(defwindow resources
  :monitor 0 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "top right" :x "7px" :y "48px" :width "170px")
  (rings))

(defwindow media
  :monitor 0 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "bottom center" :y "7px" :width "360px")
  (nowplaying))

(defwindow clock-2
  :monitor 1 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "top left" :x "7px" :y "48px" :width "150px")
  (vclock))

(defwindow resources-2
  :monitor 1 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "top right" :x "7px" :y "48px" :width "170px")
  (rings))

(defwindow media-2
  :monitor 1 :stacking "bottom" :focusable false
  :geometry (geometry :anchor "bottom center" :y "7px" :width "360px")
  (nowplaying))

;; scripts/dashboard.sh re-targets this with --screen, so :monitor is only the
;; fallback for the case where the focused monitor cannot be determined.
(defwindow dashboard
  :monitor 0 :stacking "fg" :focusable true
  :geometry (geometry :anchor "center" :width "560px")
  (dashboard-body))
