# Ghostty — replaces iTerm2. Cyberpunk neon, matching FZF_DEFAULT_OPTS,
# EZA_COLORS and ZSH_HIGHLIGHT_STYLES in zsh/.zshrc.

font-family = Hack Nerd Font
font-size = 14

background = #001f30
foreground = #e6f7f5
cursor-color = #2cf9ed
# Block rather than a bar. Also gives the smear shader a full cell to work
# with, so the trail is a solid ribbon instead of a thin line.
cursor-style = block
selection-background = #003547
selection-foreground = #ffffff

palette = 0=#001f30
palette = 1=#ff2453
palette = 2=#1dfca1
palette = 3=#f7fc17
palette = 4=#15bdf9
palette = 5=#eb46f9
palette = 6=#2cf9ed
palette = 7=#e6f7f5
palette = 8=#5c7a8a
palette = 9=#ff5c7a
palette = 10=#5cfdba
palette = 11=#fafd5c
palette = 12=#5ccffa
palette = 13=#f27dfb
palette = 14=#7dfaf3
palette = 15=#ffffff

# Background only — the text cells stay fully opaque, so glyphs don't wash out
# the way hyprland's active_opacity would fade them. nvim inherits this for free
# (tokyonight is set transparent = true), and hyprland's decoration:blur blurs
# whatever shows through.
# ponytail: 0.88 is a guess. Over the solid #001f30 desktop ground it's subtle;
# turn it down toward 0.75 once there's a wallpaper behind it.
background-opacity = 0.88

# Hyprland draws the borders.
window-decoration = false
window-padding-x = 8
window-padding-y = 4

shell-integration = zsh
# no-cursor is what makes cursor-style above actually stick: shell integration
# otherwise forces a bar at every prompt, ignoring cursor-style entirely. The
# only thing given up is automatic shape-switching for zsh vi-mode, which
# isn't set up in zsh/.zshrc anyway — every other feature keeps its default
# (title and path on, sudo and the ssh ones off).
shell-integration-features = no-cursor
copy-on-select = clipboard

# Ctrl+C copies when there's a selection, otherwise falls through as SIGINT.
# `performable:` is what makes that safe: copy_to_clipboard reports itself
# unperformable with an empty selection, so the key reaches the shell.
keybind = performable:ctrl+c=copy_to_clipboard

# Animated cursor motion. Ghostty has no built-in setting for this — it's a
# GLSL fragment shader that gets the previous and current cursor rects plus
# iTimeCursorChange, and animates the gap between them. This one is an
# overdamped spring (physics from smear-cursor.nvim): the head snaps to the new
# position while the tail lags, so the cursor visibly travels instead of
# teleporting. The trail is snapped to the cell grid and painted in TRAIL_COLOR,
# palette 14 (#7dfaf3) — the light tint of cursor-color above. TRAIL_INVERT = 1.0
# goes back to reverse-video, which picks up the palette on its own.
# Knobs live at the top of the shader; TAIL_RATE (lower = longer smear) and the
# CHAOS_* group (scatter on the first few frames) are the ones worth touching.
# shaders/cursor_blaze.glsl is the other option — a fading trail behind an
# instant jump, recolored to #2cf9ed/#eb46f9. Swap the path to go back to it.
custom-shader = shaders/smear_cursor_blocks.glsl
# `always` keeps the smear animating in unfocused windows too; `true` (default)
# only animates the focused surface.
custom-shader-animation = true

# Tab bar. window-theme = ghostty makes GTK draw the header/tab bar from the
# background/foreground above instead of the libadwaita grey, and `flat` drops
# the shadow it otherwise casts onto the terminal. gtk.css then clears the bar's
# own background so background-opacity's transparency shows through it too —
# without the CSS the bar is solid #001f30 while the grid below is not.
window-theme = ghostty
gtk-toolbar-style = flat
gtk-custom-css = gtk.css
