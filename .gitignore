# gh rewrites this and it can contain an auth token if the keychain is unavailable
gh/hosts.yml

# macOS
.DS_Store

# Machine-generated zsh files (ZDOTDIR points here, so zsh writes into the repo)
zsh/.zcompdump*
zsh/*.zwc
zsh/.zsh_history
zsh/.zsh_sessions/

# iTerm2 machine-specific paths (recreated per-machine)
iterm2/sockets
iterm2/AppSupport

# app-generated state
cagent/
com.corsair/

# local backups
yabai/disabled-launchagents/

# --- Linux app state (created by running the desktop, not config to track) ---
# Chrome's whole profile: cookies, Login Data, session tokens, caches. 4000+ files.
google-chrome/
# dconf/GNOME binary settings db, IBus socket dir, PulseAudio auth cookie
dconf/
ibus/
pulse/
# Evolution account config (contains mail account details)
evolution/
# systemd user units are symlinks systemctl enable wrote into the repo
systemd/
# per-machine desktop state
.gsd-keyboard.settings-ported
monitors.xml
user-dirs.dirs
user-dirs.locale
gtk-3.0/bookmarks

# end_4 dots-hyprland source clone (has its own .git)
dots-hyprland/

# --- HyDE ---
# Theme wallpapers: ~307MB of stock art across the 12 shipped themes, and
# redownloadable with `hyde-shell themepatcher`. The .theme files that sit
# beside them ARE tracked, since those carry the actual colors and layout.
hyde/themes/*/wallpapers/
# ...but not the hand-built theme's wallpaper. That one is not stock art and
# nothing will redownload it, so the theme is only reproducible with it tracked.
!hyde/themes/Cyberpunk Teal/wallpapers/

# Symlinks the wallpaper backend regenerates on every theme switch; they point
# into the ignored wallpapers directories, so tracking them stores dead links.
hyde/themes/*/wall.awww.png
hyde/themes/*/wall.set

# GNU parallel runtime state, written while wallbash renders templates.
parallel/

# KDE session restore state (dolphin window positions).
session/

# Firefox profile: cookies, logins.db, key4.db (the password-encryption key),
# history, and session state. 7700+ files, ~110MB, none of it config.
mozilla/

# VS Code / Code - OSS runtime state: HTTP and CachedData caches, per-session
# logs, workspace and global extension storage. Settings live in dotfiles, not here.
Code - OSS/

# Wrangler dev-server logs and its local registry socket.
.wrangler/
