# gh rewrites this and it can contain an auth token if the keychain is unavailable
gh/hosts.yml

# macOS
.DS_Store

# Machine-generated zsh files (ZDOTDIR points here, so zsh writes into the repo)
zsh/.zcompdump*
zsh/*.zwc
zsh/.zsh_history
zsh/.zsh_sessions/

# iTerm2 machine-specific paths (recreated per-machine)
iterm2/sockets
iterm2/AppSupport

# app-generated state
cagent/
com.corsair/

# local backups
yabai/disabled-launchagents/
