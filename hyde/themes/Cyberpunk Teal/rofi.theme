$HOME/.config/rofi/theme.rasi
* {
    /* Background carries alpha to match the translucent bar; e6 is the same
       weight the stock HyDE themes use for rofi. */
    main-bg:            #001f30e6;
    main-fg:            #e6f7f5ff;
    main-br:            #2cf9edff;
    main-ex:            #af87ffcc;
    select-bg:          #2cf9edff;
    select-fg:          #001f30ff;
    separatorcolor:     transparent;
    border-color:       transparent;
}
