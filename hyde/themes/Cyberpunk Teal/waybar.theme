$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* Cyberpunk Teal — colours taken from the pre-HyDE waybar/style.css.
   bar-bg keeps alpha below 1 so the `layerrule = blur,waybar` in hypr.theme
   has something to blur; at full opacity the blur is a no-op. 0.65 is the
   alpha the old bar used. */

@define-color bar-bg rgba(0, 31, 48, 0.65);

@define-color main-bg #001f30;
@define-color main-fg #e6f7f5;

/* Active workspace inverted to a cyan chip with bar-coloured text, which is
   how the old #workspaces button.active rule read. */
@define-color wb-act-bg #2cf9ed;
@define-color wb-act-fg #001f30;

/* Hover was the raised surface with cyan text, not an inversion. */
@define-color wb-hvr-bg #003547;
@define-color wb-hvr-fg #2cf9ed;
