$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
## name: Cyberpunk Teal
## blurb: Teal scheme carried over from the pre-HyDE ghostty config

# The 16 ANSI entries are copied verbatim from ghostty/config at the pre-hyde
# tag, so kitty and ghostty render the same colours for the same escape codes.

foreground               #e6f7f5
background               #001f30
selection_foreground     #ffffff
selection_background     #003547

cursor                   #2cf9ed
cursor_text_color        #001f30

url_color                #af87ff

active_tab_foreground    #001f30
active_tab_background    #2cf9ed
inactive_tab_foreground  #5c7a8a
inactive_tab_background  #003547

active_border_color      #2cf9ed
inactive_border_color    #003547

# normal
color0 #001f30
color1 #ff2453
color2 #1dfca1
color3 #f7fc17
color4 #15bdf9
color5 #eb46f9
color6 #2cf9ed
color7 #e6f7f5

# bright
color8  #5c7a8a
color9  #ff5c7a
color10 #5cfdba
color11 #fafd5c
color12 #5ccffa
color13 #f27dfb
color14 #7dfaf3
color15 #ffffff
